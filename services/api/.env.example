DATABASE_URL="postgresql://doubaohk:doubaohk_local_only@127.0.0.1:5432/doubaohk?schema=public"
API_PORT=3010
WEB_ORIGIN="http://127.0.0.1:5173,http://127.0.0.1:5174"
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
REDIS_URL="redis://127.0.0.1:6470"
AI_WORKER_CONCURRENCY=1
DOUBAO_WORKER_CONCURRENCY=1
HEALTH_REQUIRE_WORKERS=false
# 连续失败达到阈值后，账号在短时间内不能继续登录；状态只保存在 Redis。
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
# 生产环境必须使用独立的 32 字节随机 Base64 主密钥；未配置时拒绝保存第三方凭证。
CREDENTIAL_ENCRYPTION_KEY=
# 媒体账号可移植会话包使用独立的托管密钥环，不得复用 CREDENTIAL_ENCRYPTION_KEY。
# KEYRING 为 JSON：键是版本号，值是 32 字节随机 Base64 密钥；轮换时保留旧版本用于解密。
MEDIA_SESSION_KMS_ACTIVE_KEY_VERSION=
MEDIA_SESSION_KMS_KEYRING=
