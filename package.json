{
  "name": "doubao-merchant-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @doubaohk/merchant-web dev:mock -- --port 5180",
    "dev:api": "pnpm --filter @doubaohk/merchant-web dev:api -- --port 5180",
    "build": "pnpm --filter @doubaohk/merchant-web build",
    "typecheck": "pnpm --filter @doubaohk/api-contract typecheck && pnpm --filter @doubaohk/merchant-web typecheck",
    "test": "pnpm --filter @doubaohk/merchant-web test",
    "contract:generate": "pnpm --filter @doubaohk/api-contract generate",
    "lint": "eslint apps/merchant-web packages/api-contract packages/ui-tokens --max-warnings=0",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vue-eslint-parser": "10.4.1"
  },
  "msw": {
    "workerDirectory": [
      "apps/merchant-web/public"
    ]
  }
}
