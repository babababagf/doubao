{
  "name": "@doubaohk/publisher-desktop",
  "version": "0.1.23",
  "description": "豆包获客本地发布助手，负责本机账号环境与发布任务执行。",
  "author": "豆包获客",
  "private": true,
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/verify-preload.mjs",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "smoke:login": "node scripts/smoke-electron-login.mjs",
    "package:win": "pnpm build && electron-builder --win nsis && node scripts/generate-update-manifest.mjs",
    "release:verify": "node scripts/generate-update-manifest.mjs --check"
  },
  "dependencies": {
    "@doubaohk/api-contract": "workspace:*",
    "electron-updater": "6.7.3",
    "playwright-core": "1.62.1",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.1",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.2.5"
  },
  "build": {
    "appId": "top.doubaohk.publisher",
    "productName": "豆包获客发布助手",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "protocols": [
      {
        "name": "豆包获客发布助手",
        "schemes": [
          "doubaohk-publisher"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
