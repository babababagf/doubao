{
  "name": "@doubaohk/merchant-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --mode api",
    "dev:api": "vite --host 127.0.0.1 --mode api",
    "dev:mock": "vite --host 127.0.0.1 --mode mock",
    "build": "vue-tsc -b && vite build",
